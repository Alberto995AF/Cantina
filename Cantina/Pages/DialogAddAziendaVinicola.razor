@inject Cantina.Data.VinoService VinoService
@using Cantina.Data

<MudDialog>
    <DialogContent>
        <PageTitle>Create Azienda Vinicola</PageTitle>

        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <MudGrid>
                <MudItem xs="12">
                    <MudCard>
                        <MudCardContent>
                            <MudTextField Label="Nome Cantina" HelperText="Max. 8 characters"
                                          @bind-Value="model.Nome" For="@(() => model.Nome)" />
                        </MudCardContent>
                        <MudCardContent>
                            <MudTextField Label="Indirizzo" HelperText="Max. 8 characters"
                                          @bind-Value="model.Indirizzo" For="@(() => model.Indirizzo)" />
                        </MudCardContent>
                        <MudCardContent>
                            <MudStack Spacing="3" Row="true">
                                <MudAutocomplete T="Nazione" Label="Nazione" @bind-Value="selectedNazione"
                                                 SearchFunc="@functionResearchFieldNazione" ToStringFunc="@(e=> e==null?null : $"{e.Nome}")">
                                    <MoreItemsTemplate>
                                        <MudText Align="Align.Center" Class="px-4 py-1">
                                            Only the first 10 items are shown
                                        </MudText>
                                    </MoreItemsTemplate>
                                </MudAutocomplete>
                            </MudStack>
                        </MudCardContent>
                        <MudCardContent>
                            <MudStack Spacing="3" Row="true">
                                <MudAutocomplete T="RegioniItaliane" Label="Regione" @bind-Value="selectedRegione"
                                                 SearchFunc="@functionResearchFieldRegione" ToStringFunc="@(e=> e==null?null : $"{e.Nome}")">
                                    <MoreItemsTemplate>
                                        <MudText Align="Align.Center" Class="px-4 py-1">
                                            Only the first 10 items are shown
                                        </MudText>
                                    </MoreItemsTemplate>
                                </MudAutocomplete>
                            </MudStack>
                        </MudCardContent>
                        <MudCardContent>
                            <MudTextField Label="Descrizione" HelperText="Max. 8 characters"
                                          @bind-Value="model.Descrizione" For="@(() => model.Descrizione)" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">SALVA</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>


@code {
    //Vino vinoBar = new Vino();
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    AziendaVinicola model = new AziendaVinicola();

    //parametri per selezione Nazione
    Nazione selectedNazione = new();
    List<Nazione> listNazione = new List<Nazione>();

    //parametri per selezione Regione
    RegioniItaliane selectedRegione = new();
    List<RegioniItaliane> listRegione = new List<RegioniItaliane>();


    private async Task OnValidSubmit(EditContext context)
    {
        MudDialog.Close(DialogResult.Ok(model));
    }

    //funzione per restituire le Nazioni nel campo di ricerca
    private async Task<IEnumerable<Nazione>> functionResearchFieldNazione(string value)
    {
        listNazione = await VinoService.GetNazioneSearch(value);
        return listNazione;
    }

    //funzione per restituire le Regioni nel campo di ricerca
    private async Task<IEnumerable<RegioniItaliane>> functionResearchFieldRegione(string value)
    {
        listRegione = await VinoService.GetRegioneSearch(value);
        return listRegione;
    }
}