@inject Cantina.Data.VinoService VinoService
@inject IDialogService DialogService

@using Cantina.Data

<MudDialog>
    <DialogContent>
        @if (string.Compare(remORadd, "add") == 0)
        {
            <MudSelect T="int" @bind-Value="selectedYear" Label="Annata" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                @foreach (var year in annate)
                {
                    <MudSelectItem T="int" Value=@year />
                }
            </MudSelect>
        }
        else
        {
            <MudSelect T="int" Label="Annata" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                @foreach (var year in vino.Annata)
                {
                    <MudSelectItem T="int" Value=@year />
                }
            </MudSelect>
        }
        </DialogContent>
    <DialogActions>
        @if (string.Compare(remORadd, "add") == 0)
        {
            <MudButton Color="Color.Primary" OnClick="Add">Add</MudButton>
        }
        else
        {
            <MudButton Color="Color.Error" OnClick="Remove">Remove</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    Vino vinoBar = new Vino();
    MovimentiVino movimento = new MovimentiVino();
    bool disable = true;

    //gestione annate
    int annata;
    int annataPartenza = 1990;
    DateTime data = DateTime.Today;
    List<int> annate = new();
    int selectedYear;

    VinoDTO vino = new();

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public int idVino { get; set; }
    [Parameter] public string remORadd { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CreateYears();
        AnnateCantina();
    }

    void Add()
    {
        if(selectedYear != 0)
        {
            movimento.VinoId = idVino;
            movimento.Movimento = 1;
            movimento.Annata = selectedYear;
            movimento.Data = DateTime.Now;
            movimento.Prezzo = 0;
            movimento.Note = "-";
            MudDialog.Close(DialogResult.Ok(movimento));
        }
    }

    void Remove()
    {
        if(selectedYear != 0)
        {
            movimento.VinoId = idVino;
            movimento.Movimento = -1;
            movimento.Annata = selectedYear;
            movimento.Data = DateTime.Now;
            movimento.Prezzo = 0;
            movimento.Note = "-";
            MudDialog.Close(DialogResult.Ok(movimento));
        }
    }

    protected async Task CreateYears()
    {
        for(int i = 0; annataPartenza <= data.Year; i++)
        {
            annate.Add(annataPartenza);
            annataPartenza++;
        }
    }

    protected async Task AnnateCantina()
    {
        //chiamiamo una funzione che estrai tutte le annate disponibili per quel vino particolare
        vino = await VinoService.GetVinoIDdto(idVino);
    }
}
