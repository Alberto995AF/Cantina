            </MudItem>
            <MudItem>
                <MudTooltip Text="Tutti i vini">
                    <MudIconButton Href="/cantinaalbe" Icon="@Icons.Filled.List" aria-label="modView"></MudIconButton>
                </MudTooltip>
            </MudItem>
        </MudStack>
    </MudItem>
