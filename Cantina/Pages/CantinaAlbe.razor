@page "/cantinaalbe"

<PageTitle>Cantina</PageTitle>

@using Cantina.Data
@inject Cantina.Data.VinoService VinoService
@inject NavigationManager NavigationManager



<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h4">CANTINA</MudText>
    </MudItem>
    <MudItem xs="12" sm="12">
        <MudPaper Elevation="3" Class="pa-3">
            <MudStack>
                <MudAutocomplete T="VinoDTO" ResetValueOnEmptyText="true" Label="Cerca vino.." CoerceText="true" ValueChanged="@(x => Register(x))"
                                 SearchFunc="@functionResearchField" ToStringFunc="@(e=> e==null?null : $"{e.Nome} - {e.AziendaVinicola} ")">
                    <MoreItemsTemplate>
                        <MudText Align="Align.Center" Class="px-4 py-1">
                            Only the first 10 items are shown
                        </MudText>
                    </MoreItemsTemplate>
                </MudAutocomplete>
            </MudStack>
        </MudPaper>
    </MudItem>
    @foreach (var item in listaVini)
    {
        <MudItem xs="12" sm="3">
            <MudCard Elevation="5" @onclick="() => OnclickDetail(item.ID)" Height="400px">
                <MudCardContent>
                    <MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudImage Width="64" Height="240" Src=@item.linkImmagine Alt="Mony the dog" Class="rounded-lg" />
                            <MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Filled.Numbers" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6">@item.bottglieInCantina</MudText>
                                </MudStack>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h5">@item.Nome</MudText>
                        <MudText Typo="Typo.h6">@item.AziendaVinicola</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>


@code {
    private List<VinoDTO> listaVini = new();

    //parametri per la ricerca
    List<VinoDTO> vinoListResearch = new();

    protected override async Task OnInitializedAsync()
    {
        listaVini = await VinoService.GetViniCantina();
    }

    protected async Task OnclickDetail(int id)
    {
        NavigationManager.NavigateTo("/dettaglivino/" + id);
    }

    protected async Task Register(VinoDTO vino)
    {
        listaVini.Clear();
        if (vino == null)
            listaVini = await VinoService.GetViniCantina();
        else
            listaVini.Add(vino);
    }

    private async Task<IEnumerable<VinoDTO>> functionResearchField(string value)
    {
        //chiamo una funzione che in base a quello che è stato digitato tira fuori i vini che corrispondono
        //alla ricerca
        if (value is null)
        {
            vinoListResearch = null;
            //listaVini = await VinoService.GetVini();
        }
        else
        {
            vinoListResearch = await VinoService.GetVinoDTOCantinaSearch(value);
        }

        if (vinoListResearch != null)
        {
            listaVini.Clear();
            listaVini = vinoListResearch;
        }
        //listaVini = vinoListResearch;
        return vinoListResearch;
    }
}