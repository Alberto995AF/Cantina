<MudGrid>
    <MudItem xs="12" sm="12">
        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudItem>
                <MudText Typo="Typo.h4">CANTINA</MudText>
            </MudItem>
            <MudItem>
                <MudStack Row="true">
                    <MudTooltip Text="Lista">
                        <MudIconButton Href="/vinicantina_cardview" Icon="@Icons.Material.Filled.CalendarViewMonth" aria-label="modView"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="Lista">
                        <MudIconButton Href="/vinicantina_aziendaview" Icon="@Icons.Material.Filled.House" aria-label="modView"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="Per denominazione">
                        <MudIconButton Href="/vinicantina_denomiview" Icon="@Icons.Material.Filled.Terrain" aria-label="modView"></MudIconButton>
                    </MudTooltip>
                </MudStack>

            </MudItem>
        </MudStack>
    </MudItem>
    <MudItem xs="12" sm="12">
        <MudDataGrid T="VinoDTO" ReadOnly="false" Items="@listaVini" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter" Hideable="true" RowsPerPage="25">
            <ToolBarContent>
                @*<MudText Typo="Typo.h6">Periodic Elements</MudText>
            <MudSpacer />*@
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <Columns>
                @*<SelectColumn T="VinoDTO" />*@
                <PropertyColumn Property="x => x.Nome" Title="Nome" Sortable="false" Filterable="true" />
                <PropertyColumn Property="x => x.AziendaVinicola" Title="Cantina" Sortable="false" />
                <PropertyColumn Property="x => x.tipoVino" Title="Tipo Vino" Sortable="false" />
                <PropertyColumn Property="x => x.Denominazione" Title="Denominazione" Sortable="false" />
                <PropertyColumn Property="x => x.avgPrice" Title="Prezzo Medio" Sortable="false" />
                @*<TemplateColumn CellClass="d-flex justify-end" Sortable="false" Filterable="false">  // tolto per impedire la modifica dalla pagina della cantina
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" @onclick="() => StartedEditingItem((VinoDTO)context.Item)" />
                    </CellTemplate>
                </TemplateColumn>*@
            </Columns>
            <PagerContent>
                <MudDataGridPager T="VinoDTO" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>

</MudGrid>


