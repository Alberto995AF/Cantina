    <DialogContent>
        <MudStack>
            <MudTable Items="@vinoList" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>AziendaVinicola</MudTh>
                    <MudTh>inCantina</MudTh>
                    <MudTh>Bottigle</MudTh>
                    <MudTh>Edit</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.Nome</MudTd>
                    <MudTd DataLabel="AziendaVinicola">@context.AziendaVinicola</MudTd>
                    <MudTd DataLabel="inCantina">@context.inCantina</MudTd>
                    <MudTd DataLabel="Bottigle">@context.bottglieInCantina</MudTd>
                    <MudTd DataLabel="Edit">
                        <MudSelect T="int" @bind-Value="selectedYear" Label="Annata" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var year in annate)
                            {
                                <MudSelectItem T="int" Value=@year />
                            }
                        </MudSelect>
                        <MudTextField Label="Prezzo" @bind-Value="price" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" @onclick="() => Add(context.ID)">Add</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" @onclick="() => Remove(context.ID)">Remove</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudStack AlignItems="AlignItems.End">
            </MudStack>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    Vino vinoBar = new Vino();
    MovimentiVino movimento = new MovimentiVino();
    int newAnnata;
    bool disable = true;
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public VinoDTO vino { get; set; }
    List<VinoDTO> vinoList = new();

    decimal price;

    //gestione annate
    int annata;
    int annataPartenza = 1990;
    DateTime data = DateTime.Today;
    List<int> annate = new();
    int selectedYear;

    protected override async Task OnInitializedAsync()
    {
        vinoList.Add(vino);
        CreateYears();
    }


    protected async Task AddVino(int idVino)
    {
        var dialog = DialogService.Show<DialogNewAnnata>("New Annata Dialog");

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            newAnnata = (int)result.Data;
        }
        int id = await VinoService.AddVinoNewAnnata(idVino, newAnnata);
        Add(id);
    }

    void Add(int idVino)
    {
        if(selectedYear != 0)
        {
            movimento.VinoId = idVino;
            movimento.Movimento = 1;
            movimento.Annata = selectedYear;
            movimento.Data = DateTime.Now;
            movimento.Prezzo = price;
            movimento.Note = "-";
            MudDialog.Close(DialogResult.Ok(movimento));
        }
    }

    void Remove(int idVino)
    {
        if(selectedYear != 0)
        {
            bool result = VinoService.CheckMovimento(idVino, selectedYear);
            if(!result)
            {
                MudDialog.Close(DialogResult.Cancel());
            }
            movimento.VinoId = idVino;
            movimento.Movimento = -1;
            movimento.Annata = selectedYear;
            movimento.Data = DateTime.Now;
            movimento.Prezzo = 0;
            movimento.Note = "-";
            MudDialog.Close(DialogResult.Ok(movimento));
        }
    }

    protected async Task CreateYears()
    {
        for (int i = 0; annataPartenza <= data.Year; i++)
        {
            annate.Add(annataPartenza);
            annataPartenza++;
        }
    }
}
