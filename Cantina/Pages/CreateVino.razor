@page "/createvino"

@inject Cantina.Data.VinoService VinoService
@using System.ComponentModel.DataAnnotations
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@using Cantina.Data

<PageTitle>Create Vino</PageTitle>

<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudCard>
                <MudCardContent>
                    <MudTextField Label="Nome Vino" @bind-Value="model.Nome" For="@(() => model.Nome)" />
                </MudCardContent>
                <MudCardContent>
                    <MudStack Spacing="3" Row="true">
                        <MudAutocomplete T="AziendaVinicola" Label="Cantine" @bind-Value="selectedAziendaVino"
                                         SearchFunc="@functionResearchFieldAzienda" ToStringFunc="@(e=> e==null?null : $"{e.Nome}")">
                            <MoreItemsTemplate>
                                <MudText Align="Align.Center" Class="px-4 py-1">
                                    Only the first 10 items are shown
                                </MudText>
                            </MoreItemsTemplate>
                        </MudAutocomplete>
                        <MudItem xs="12" sm="6" md="4">
                            <MudFab Color="Color.Primary" OnClick="@AddCantina" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        </MudItem>
                    </MudStack>
                </MudCardContent>
                <MudCardContent>
                    <MudAutocomplete T="tipoVino" Label="Tipo Vino" @bind-Value="selectedTipoVino"
                                     SearchFunc="@functionResearchFieldTipoVino" ToStringFunc="@(e=> e==null?null : $"{e.Tipo}")">
                        <MoreItemsTemplate>
                            <MudText Align="Align.Center" Class="px-4 py-1">
                                Only the first 10 items are shown
                            </MudText>
                        </MoreItemsTemplate>
                    </MudAutocomplete>
                </MudCardContent>
                <MudCardContent>
                    <MudStack Spacing="3" Row="true">
                        <MudAutocomplete T="Denominazione" Label="Denominazione" @bind-Value="selectedDenominazione"
                                         SearchFunc="@functionResearchFieldDenominazione" ToStringFunc="@(e=> e==null?null : $"{e.Nome}")">
                            <MoreItemsTemplate>
                                <MudText Align="Align.Center" Class="px-4 py-1">
                                    Only the first 10 items are shown
                                </MudText>
                            </MoreItemsTemplate>
                        </MudAutocomplete>
                        <MudItem xs="12" sm="6" md="4">
                            <MudFab Color="Color.Primary" OnClick="@AddDenominazione" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        </MudItem>
                    </MudStack>
                </MudCardContent>
                <MudCardContent>
                    <MudStack Spacing="3" Row="true">
                        <MudSelect T="Uva" Label="Tipo Uva" MultiSelection="true" @bind-Value="Uva" ToStringFunc="@(e=> e==null?null : $"{e.Nome}")" @bind-SelectedValues="selectedUva">
                            @foreach (var uva in listUva)
                            {
                                <MudSelectItem T="Uva" Value="@uva">@uva.Nome</MudSelectItem>
                            }
                        </MudSelect>
                        <MudItem xs="12" sm="6" md="4">
                            <MudFab Color="Color.Primary" OnClick="@AddUva" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        </MudItem>
                    </MudStack>
                </MudCardContent>
                <MudCardContent>
                    <MudTextField Label="Barcode" @bind-Value="model.Barcode" For="@(() => model.Barcode)" />
                </MudCardContent>
                <MudCardContent>
                    <MudTextField Label="Link Vivino" @bind-Value="model.linkAppVivino" For="@(() => model.linkAppVivino)" />
                </MudCardContent>
                <MudCardContent>
                    <MudTextField Label="Link Tannico" @bind-Value="model.linkAppTannico" For="@(() => model.linkAppTannico)" />
                </MudCardContent>
                <MudCardContent>
                    <MudTextField Label="Link Immagine" @bind-Value="model.linkImmagine" For="@(() => model.linkImmagine)" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>


@code {
    Vino model = new Vino();
    bool success;
    private bool resetValueOnEmptyText;
    private bool coerceText;
    private bool coerceValue;

    //parametri per aziendeVinicole
    AziendaVinicola selectedAziendaVino = new();
    List<AziendaVinicola> listAziende = new List<AziendaVinicola>();

    //parametri per selezione tipo vino
    List<tipoVino> listTipoVino = new List<tipoVino>();
    tipoVino selectedTipoVino = new();

    //parametri per la selezione della denomincazione
    List<Denominazione> listDenominazioni = new();
    Denominazione selectedDenominazione = new();

    //parametri per la selezione dell'uva
    Uva Uva = new();
    List<Uva> listUva = new();
    private IEnumerable<Uva> selectedUva { get; set; } = new HashSet<Uva>();


    protected override async Task OnInitializedAsync()
    {
        listAziende = await VinoService.GetAziende();
        listTipoVino = await VinoService.GetTipoVino();
        listUva = await VinoService.GetUvaSearch();
    }

    private async Task OnValidSubmit(EditContext context)
    {
        model.AziendaVinicolaId = selectedAziendaVino.ID;
        model.tipoVinoId = selectedTipoVino.ID;
        model.DenominazioneVinoId = selectedDenominazione.ID;
        if (model.linkImmagine == null)
            model.linkImmagine = "https://www.vivino.com/packs/f1b798fa2a2afa4f598391f35cba7e57.png";
        success = true;
        await VinoService.AddVino(model);

        //devo creare un oggetto UvaViino per ogni tipo di iva presente nel vino selezionata
        List<UvaVino> uvaVinoList = new();
        foreach (var items in selectedUva)
        {
            UvaVino uvaVino = new();
            uvaVino.VinoId = model.ID;
            uvaVino.UvaId = items.ID;
            uvaVinoList.Add(uvaVino);
        }
        await VinoService.AddUvaVino(uvaVinoList);
        NavigationManager.NavigateTo("/viniviewcard");
    }

    protected async Task AddCantina()
    {
        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<DialogAddAziendaVinicola>("Aggiungi Cantina", maxWidth);
        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (AziendaVinicola)result.Data;
            await VinoService.AddAziendaVinicola(newItem);
        }
    }

    protected async Task AddDenominazione()
    {
        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<DialogAddDenominazione>("Aggiungi Denominazione", maxWidth);
        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (Denominazione)result.Data;
            await VinoService.AddDenominazione(newItem);
        }
    }

    protected async Task AddUva()
    {
        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<DialogAddUva>("Aggiungi Uva", maxWidth);
        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (Uva)result.Data;
            await VinoService.AddUva(newItem);
        }

    }

    //funzione per restituire le cantine nel campo di ricerca
    private async Task<IEnumerable<AziendaVinicola>> functionResearchFieldAzienda(string value)
    {
        listAziende = await VinoService.GetAziendeSearch(value);

        return listAziende;
    }

    //funzione per restituire le cantine nel campo di ricerca
    private async Task<IEnumerable<tipoVino>> functionResearchFieldTipoVino(string value)
    {
        listTipoVino = await VinoService.GetTipoVinoSearch(value);

        return listTipoVino;
    }

    //funzione per restituire le denomincazioni nel campo di ricerca
    private async Task<IEnumerable<Denominazione>> functionResearchFieldDenominazione(string value)
    {
        listDenominazioni = await VinoService.GetDenominazioneSearch(value);

        return listDenominazioni;
    }
}