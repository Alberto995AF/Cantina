@page "/index_old"
@inject Cantina.Data.VinoService VinoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@using Cantina.Data

<PageTitle>Index</PageTitle>

<h1>Cantina</h1>

<MudGrid>
    <MudItem xs="12" sm="12">
        <MudPaper Elevation="3" Class="pa-3">
            <MudStack>
                <MudStack>
                    <MudNumericField AutoFocus="true" HideSpinButtons="true" @bind-Value="@barcode_ins" Immediate="true" @onkeydown="@pressEnter" Clearable="true" Label="Standard" Variant="Variant.Text" />
                </MudStack>
                @*<MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.End">
                    <MudButton id="btnSubmit" OnClick="Register" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</MudButton>
                </MudStack>*@
            </MudStack>
            @*<EditForm Model="@vinoBar">
                <MudStack>
                    <MudStack>
                        <MudPaper Elevation="0" Class="border-b-2 border-solid mud-border-primary px-2">
                            <InputNumber style="width:100%; height:40px" @bind-Value="@barcode_ins" placeholder="Inserisci Barcode" onkeydown="onEnterClickTo(event, 'btnSubmit');"></InputNumber>
                        </MudPaper>
                    </MudStack>
                    <MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.End">
                        <MudButton id="btnSubmit" OnClick="Register" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</MudButton>
                    </MudStack>
                </MudStack>
            </EditForm>*@
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="3" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudStack>
                    <MudIcon Icon="@Icons.Filled.Payment" Color="Color.Primary" Size="Size.Large" />
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.button">Bottiglie Acquistate</MudText>
                    <MudText Typo="Typo.h6">@numBottigleAcquistate</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="3" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudStack>
                    <MudIcon Icon="@Icons.Filled.WineBar" Color="Color.Error" Size="Size.Large" />
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.button">Bottiglie Bevute</MudText>
                    <MudText Typo="Typo.h6">@numBottiglieBevute</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="3" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudStack>
                    <MudIcon Icon="@Icons.Filled.Liquor" Color="Color.Primary" Size="Size.Large" />
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.button">Bottiglie in Cantina</MudText>
                    <MudText Typo="Typo.h6">@numBottiglieCantina</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="8">
        <MudCard Elevation="3" Class="pa-3" Style="height:100%; width:100%">
            <MudCarousel Class="mud-width-full" ShowArrows="false" ShowBullets="false" Style="height:100%; " AutoCycle="true" TData="object">
                @foreach (var item in listaVini)
                {
                    <MudCarouselItem Transition="transition">
                        <div class="d-flex flex-grow-1">
                            <MudStack Class="flex-1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudImage Width="64" Height="240" Src=@item.linkImmagine Alt="Mony the dog" Class="rounded-lg" />
                                    <MudStack>
                                        <MudStack AlignItems="AlignItems.Center" Row="true">
                                            <MudIcon Icon="@Icons.Filled.Liquor" Color="Color.Primary" />
                                            <MudText Typo="Typo.h6">  @item.bottglieInCantina</MudText>
                                        </MudStack>
                                        <MudStack AlignItems="AlignItems.Center" Row="true">
                                            <MudIcon Icon="@Icons.Filled.Euro" Color="Color.Secondary" />
                                            <MudText Typo="Typo.h6">  @item.QuantitàBottiglePossedute</MudText>
                                        </MudStack>
                                        <MudStack AlignItems="AlignItems.Center" Row="true">
                                            <MudIcon Icon="@Icons.Filled.WineBar" Color="Color.Secondary" />
                                            <MudText Typo="Typo.h6">  @item.bottiglieBevute</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.h5">@item.Nome</MudText>
                                <MudText Typo="Typo.h6">@item.AziendaVinicola</MudText>
                            </MudStack>
                        </div>
                    </MudCarouselItem>
                }
            </MudCarousel>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-3" Elevation="3">
            <MudChart ChartType="ChartType.Donut" Width="300px" Height="300px" InputData="@data" InputLabels="@labelsCircle"></MudChart>
        </MudPaper>
    </MudItem>
</MudGrid>


@code {
    Vino vinoBar = new Vino();
    bool success;
    int barcode_ins;
    int numBottiglieBevute;
    int numBottiglieCantina;
    int numBottigleAcquistate;
    int numTotaleViniSlide;
    List<VinoDTO> vinoList = new();
    List<VinoDTO> listaVini = new();
    List<int> numeriBottiglie = new();
    List<tipoVino> tipiVino = new();
    List<MovimentiVino> listaMovimentiTotale = new();
    List<MovimentiVino> listaMovimentiRidotta = new();
    int dataSizeCircleChart;
    private Transition transition = Transition.Slide;
    string[] labelsCircle;
    double[] data;

    protected override async Task OnInitializedAsync()
    {
        listaVini = await VinoService.GetViniRandom();
        numTotaleViniSlide = listaVini.Count();

        numeriBottiglie = await VinoService.GetInfoNumeriche();
        numBottiglieBevute = numeriBottiglie[0];
        numBottiglieCantina = numeriBottiglie[1];
        numBottigleAcquistate = numeriBottiglie[2];

        listaMovimentiTotale = await VinoService.GetMovimenti();

        //prendo tutti i tipi di vino
        tipiVino = await VinoService.GetTipiVino();
        dataSizeCircleChart = tipiVino.Count();

        labelsCircle= new string[dataSizeCircleChart];
        data = new double[dataSizeCircleChart];

        int i = 0;
        foreach (var item in tipiVino)
        {
            if (item.Tipo == "Rosso")
            {
                labelsCircle[0] = item.Tipo;
                data[0] = numeriBottiglie[3];
            }

            if (item.Tipo == "Bianco")
            {
                labelsCircle[1] = item.Tipo;
                data[1] = numeriBottiglie[4];
            }

            if (item.Tipo == "Bianco Frizzante")
            {
                labelsCircle[2] = item.Tipo;
                data[2] = numeriBottiglie[5];
            }

            if (item.Tipo == "Prosecco")
            {
                labelsCircle[3] = item.Tipo;
                data[3] = numeriBottiglie[6];
            }

            if (item.Tipo == "Champagne")
            {
                labelsCircle[4] = item.Tipo;
                data[4] = numeriBottiglie[7];
            }
        }
    }

    protected async Task Register()
    {
        vinoList = await VinoService.GetVinoBarcodeDTO(barcode_ins);
        if (vinoList.Count() == 0)
        {
            Snackbar.Add("Errore: Vino non trovato", Severity.Error, config =>
            {
                config.RequireInteraction = false;
                config.ShowCloseIcon = false;
                config.VisibleStateDuration = 2000;
                config.ShowTransitionDuration = 500;
                config.Onclick = snackbar =>
                {
                    return Task.CompletedTask;
                };
            });
            return;
        }

        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameter = new DialogParameters();
        parameter.Add("vino", vinoList);

        var dialog = DialogService.Show<DialogAddOrRemoveVino>("AddOrRemoveVino Dialog", parameter, maxWidth);

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (MovimentiVino)result.Data;
            await VinoService.AddMovimento(newItem);
        }

    }

    protected async Task pressEnter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            Register();
        }
    }
}
