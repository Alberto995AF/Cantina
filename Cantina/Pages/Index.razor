    protected async Task Register(VinoDTO vino)
    {
        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameter = new DialogParameters();
        parameter.Add("vino", vino);

        var dialog = DialogService.Show<DialogAddOrRemoveVino>("AddOrRemoveVino Dialog", parameter, maxWidth);

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (MovimentiVino)result.Data;
            await VinoService.AddMovimento(newItem);
        }
        else
        {
            Snackbar.Add("Errore: Vino da rimuovere non trovato", Severity.Error, config =>
            {
                config.RequireInteraction = false;
                config.ShowCloseIcon = false;
                config.VisibleStateDuration = 2000;
                config.ShowTransitionDuration = 500;
                config.Onclick = snackbar =>
                {
                    return Task.CompletedTask;
                };
            });
        }
    }


