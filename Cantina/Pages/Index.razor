                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="3" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudStack>
                    <MudIcon Icon="@Icons.Filled.Liquor" Color="Color.Primary" Size="Size.Large" />
                </MudStack>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.button">Bottiglie in Cantina</MudText>
                    <MudText Typo="Typo.h6">@numBottiglieCantina</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>


