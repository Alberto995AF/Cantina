@page "/dettaglivino/{VinoID:int?}"

@inject IDialogService DialogService

<PageTitle>Dettagli Vini</PageTitle>


@using Cantina.Data

@inject Cantina.Data.VinoService VinoService
@inject IDialogService DialogService
@using Microsoft.Extensions.Primitives;
@inject NavigationManager NavigationManager

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="6" Class="d-flex align-center justify-center mud-width-full py-8 my-10">
        <MudImage Width="128" Height="500" Src=@vino.linkImmagine Alt="Mony the dog" Class="rounded-lg" />
    </MudItem>
    <MudItem xs="12" sm="6" Class="my-10">
        <MudGrid>
            <MudStack AlignItems="AlignItems.Center" Row="true">
                <MudText Typo="Typo.h6">@vino.AziendaVinicola</MudText>
                @if (prefVino)
                {
                    <MudIconButton @onclick="changeFavorite" Color="@Color.Success" Icon="@Icons.TwoTone.Bookmark" aria-label="Favorite"></MudIconButton>
                }
                else
                {
                    <MudIconButton @onclick="changeFavorite" Color="@Color.Error" Icon="@Icons.TwoTone.BookmarkBorder" aria-label="Not Favorite"></MudIconButton>
                }
            </MudStack>

            <MudItem xs="12">
                <MudStack Row="true" Spacing="16">
                    <MudText Typo="Typo.h3">@vino.Nome</MudText> 
                    <MudText>
                        <MudText Typo="Typo.h3">@vino.avgPrice €</MudText>
                    </MudText>
                </MudStack>
            </MudItem>
            <MudItem xs="12">
                <MudStack>
                    <MudText>· @vino.Nazione · @vino.Regione · @vino.Denominazione </MudText>
                    <MudStack Row="true">
                        @foreach (var uva in vino.Uva)
                        {
                            <MudText>· @uva</MudText>
                        }
                    </MudStack>
                </MudStack>
                <MudDivider DividerType="DividerType.Middle" Class="my-6" />
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true">
                    <MudItem xs="4">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Filled.Euro" Color="Color.Secondary" />
                            <MudText Typo="Typo.h6">  @vino.QuantitàBottiglePossedute</MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="4">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Filled.Liquor" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">  @vino.bottglieInCantina</MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="4">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Filled.WineBar" Color="Color.Error" />
                            <MudText Typo="Typo.h6"> @vino.bottiglieBevute</MudText>
                        </MudStack>
                    </MudItem>
                </MudStack>
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true">
                    <MudLink Href="@vino.linkAppVivino">
                        <MudImage Src="data:image/png;base64," Alt="Vivino" Width="50" Height="50" Class="rounded-lg" />
                    </MudLink>
                    <MudLink Href="@vino.linkAppVivino">
                        <MudImage Src="https://media-exp1.licdn.com/dms/image/C4E0BAQH4Z-BriCwhrw/company-logo_200_200/0/1519867265006?e=2147483647&v=beta&t=58bqf-jgMXlIbs58FQi05gLtvDDGhFnPjU2aTyCfpGg" Alt="Tannico" Width="50" Height="50" Class="rounded-lg" />
                    </MudLink>
                </MudStack>
            </MudItem>
            <MudItem xs="12" Class="">
                <MudStack>
                    <MudStack Row="true">
                        <MudIcon Icon="@Icons.Filled.RemoveCircle" @onclick="() => OnButtonClickedRemove(vino.ID)" Size="Size.Large" Color="Color.Error" Title="Remove" />
                        <MudIcon Icon="@Icons.Filled.AddCircle" @onclick="() => OnButtonClickedAdd(vino.ID)" Size="Size.Large" Color="Color.Success" Title="Add" />
                    </MudStack>
                    <MudGrid Class="mt-5">
                        <MudItem xs="12" sm="12">Annate presenti</MudItem>
                        @foreach (var item in vino.annoPrezzo)
                        {
                            <MudItem xs="3" sm="3">
                                <MudPaper Class="d-flex align-center justify-center mud-width-full py-5">
                                    <MudStack>
                                        <MudText>@item.annata (@item.prezzo€)</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudItem>
