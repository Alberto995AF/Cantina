                    </MudStack>
                </MudItem>
            </MudStack>
        </MudItem>*@
    <MudItem xs="12" sm="12">
        <MudDivider DividerType="DividerType.Middle" Class="my-12" />
    </MudItem>
    <MudItem xs="12" sm="12" Class="d-flex align-center justify-center ">
        <MudText Typo="Typo.h4">Potrebbe interessarti anche</MudText>
    </MudItem>
    @foreach (var item in listaVini)
    {
        <MudItem xs="12" sm="3">
            <MudCard id="detailCard" Elevation="5" @onclick="() => OnclickDetail(item.ID)" Height="400px">
                <MudCardContent id="detailCard">
                    <MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudImage Width="64" Height="240" Src=@item.linkImmagine Alt="Mony the dog" Class="rounded-lg" />
                            <MudStack>
                                <MudStack AlignItems="AlignItems.Center" Row="true">
                                    <MudIcon Icon="@Icons.Filled.Liquor" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6">  @item.bottglieInCantina</MudText>
                                </MudStack>
                                <MudStack AlignItems="AlignItems.Center" Row="true">
                                    <MudIcon Icon="@Icons.Filled.Euro" Color="Color.Secondary" />
                                    <MudText Typo="Typo.h6">  @item.QuantitàBottiglePossedute</MudText>
                                </MudStack>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.h5">@item.Nome</MudText>
                        <MudText Typo="Typo.h6">@item.AziendaVinicola</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>



@code {
    private List<VinoDTO> listaVini = new();

    [Parameter]
    public int VinoID { get; set; } = 0;

    //Variabile per i preferiti
    public bool prefVino { get; set; }

    string state = "Message box hasn't been opened yet";

    //parametro per mostrare o il pulsnate di aggiunta o il pulsante di remove nella dialog
    string remORadd = "";

    public VinoDTO vino = new();

    //prendiamo l'ID del vino cliccato
    protected override async void OnInitialized()
    {
        vino = await VinoService.GetVinoIDdto(VinoID);
        prefVino = vino.Preferito;
        listaVini = await VinoService.GetViniAziendaVinicola(vino.AziendaVinicolaId, vino.ID);
    }

    //Dettagli Vino - TODO: non funziona
    protected async Task OnclickDetail(int id)
    {
        NavigationManager.NavigateTo("/dettaglivino/" + id);
    }

    private async void OnButtonClickedAdd(int idVino)
    {
        //bool? result = await DialogService.ShowMessageBox(
        //    "Attenzione",
        //    "Vuoi aggiungere questo vino alla tua cantina?",
        //    yesText: "Aggiungi", cancelText: "Cancel");
        //state = result == null ? "Cancel" : "Aggiungi";
        //MovimentiVino movVino = new();
        remORadd = "add";
        var parameter = new DialogParameters();
        parameter.Add("idVino", idVino);
        parameter.Add("remORadd", remORadd);

        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<DialogAddOrRemoveWineYear>("AddOrRemoveVino Dialog", parameter, maxWidth);

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (MovimentiVino)result.Data;
            await VinoService.AddMovimento(newItem);
        }

        StateHasChanged();

    }

    private async void OnButtonClickedRemove(int idVino)
    {
        //bool? result = await DialogService.ShowMessageBox(
        //    "Attenzione",
        //    "Vuoi rimuovere questo vino dalla tua cantina?",
        //    yesText: "Rimuovi", cancelText: "Cancel");
        //state = result == null ? "Cancel" : "Rimuovi";

        //if (result == true)
        //{
        //    MovimentiVino item = new MovimentiVino();
        //    item.VinoId = id;
        //    item.Data = DateTime.Now;
        //    item.Movimento = -1;
        //    item.Prezzo = 0;
        //    item.Note = "-";
        //    await VinoService.AddMovimento(item);
        //}

        remORadd = "remove";
        var parameter = new DialogParameters();
        parameter.Add("idVino", idVino);
        parameter.Add("remORadd", remORadd);

        DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<DialogAddOrRemoveWineYear>("AddOrRemoveVino Dialog", parameter, maxWidth);

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            var newItem = (MovimentiVino)result.Data;
            await VinoService.AddMovimento(newItem);
        }

        StateHasChanged();
    }


    //Funzione per inserire o togliere un vino dai preferiti
    private async void changeFavorite()
    {
        if (prefVino)
            prefVino = false;
        else
            prefVino = true;

        await VinoService.ChangeFavorite(VinoID, prefVino);
        StateHasChanged();
    }

}



